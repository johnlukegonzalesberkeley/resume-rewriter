# Get a free key at https://aistudio.google.com (not needed in demo mode)
GEMINI_API_KEY=your-key-here

# Demo mode: skip Gemini and return placeholder rewrites. No API key needed.
# MOCK_LLM=1

# Optional settings
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_THINKING_BUDGET=0
# Comma-separated list of frontend addresses allowed to call this API
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
